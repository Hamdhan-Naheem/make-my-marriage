# Copy to apps/api/.env for local API development.
PORT=4000
DATABASE_URL=postgresql://make_my_marriage:make_my_marriage_password@127.0.0.1:5433/make_my_marriage?schema=public
# Production only: use Neon's direct (non-pooler) URL for Prisma CLI migrations.
# Local development may omit this and continue using DATABASE_URL.
# DIRECT_URL=postgresql://user:password@host/database?sslmode=require
# Must be a separate database whose name ends in _test. Test commands enforce both rules.
TEST_DATABASE_URL=postgresql://make_my_marriage:make_my_marriage_password@127.0.0.1:5433/make_my_marriage_test?schema=public
WEB_ORIGIN=http://localhost:3000
# Replace both placeholders with different cryptographically random local values.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
# Use private Resend configuration. Never expose these through NEXT_PUBLIC_ variables.
RESEND_API_KEY=re_replace-with-your-resend-api-key
AUTH_EMAIL_FROM=Make My Marriage <verification@example.com>
