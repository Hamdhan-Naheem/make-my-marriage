# Copy to apps/api/.env for local API development.
PORT=4000
DATABASE_URL=postgresql://make_my_marriage:make_my_marriage_password@127.0.0.1:5433/make_my_marriage?schema=public
# Must be a separate database whose name ends in _test. Test commands enforce both rules.
TEST_DATABASE_URL=postgresql://make_my_marriage:make_my_marriage_password@127.0.0.1:5433/make_my_marriage_test?schema=public
WEB_ORIGIN=http://localhost:3000
# Replace both placeholders with different cryptographically random local values.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
# Local development only. Keep false until intentionally testing unverified sign-in.
AUTH_ALLOW_UNVERIFIED_DEV=false
