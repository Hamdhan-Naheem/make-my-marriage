generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(320)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String?   @map("last_name") @db.VarChar(100)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions               Session[]
  emailVerificationToken EmailVerificationToken?
  createdWeddings        Wedding[]               @relation("WeddingCreator")
  createdEvents          Event[]                 @relation("EventCreator")
  weddingMemberships     WeddingMember[]

  @@map("users")
}

enum WeddingManagementType {
  BRIDE_SIDE
  GROOM_SIDE
  JOINT

  @@map("wedding_management_type")
}

enum WeddingMemberRole {
  OWNER
  ADMIN
  FAMILY_MEMBER
  COLLABORATOR

  @@map("wedding_member_role")
}

enum WeddingSide {
  BRIDE
  GROOM
  BOTH

  @@map("wedding_side")
}

model Wedding {
  id              String                @id @default(uuid()) @db.Uuid
  name            String                @db.VarChar(120)
  brideName       String                @map("bride_name") @db.VarChar(100)
  groomName       String                @map("groom_name") @db.VarChar(100)
  managementType  WeddingManagementType @map("management_type")
  mainWeddingDate DateTime?             @map("main_wedding_date") @db.Date
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime?             @map("archived_at") @db.Timestamptz(3)

  createdBy User            @relation("WeddingCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members   WeddingMember[]
  events    Event[]

  @@index([createdByUserId])
  @@map("weddings")
}

model WeddingMember {
  id        String            @id @default(uuid()) @db.Uuid
  weddingId String            @map("wedding_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  role      WeddingMemberRole
  side      WeddingSide
  isActive  Boolean           @default(true) @map("is_active")
  joinedAt  DateTime          @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([weddingId, userId])
  @@unique([weddingId, id])
  @@index([weddingId])
  @@index([userId])
  @@map("wedding_members")
}

model Event {
  id              String      @id @default(uuid()) @db.Uuid
  weddingId       String      @map("wedding_id") @db.Uuid
  name            String      @db.VarChar(120)
  description     String?     @db.VarChar(1000)
  side            WeddingSide
  eventDate       DateTime?   @map("event_date") @db.Date
  startTime       DateTime?   @map("start_time") @db.Time(0)
  endTime         DateTime?   @map("end_time") @db.Time(0)
  venueName       String?     @map("venue_name") @db.VarChar(160)
  address         String?     @db.VarChar(500)
  createdByUserId String      @map("created_by_user_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  createdBy User    @relation("EventCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([weddingId, id])
  @@index([weddingId])
  @@index([weddingId, eventDate])
  @@index([createdByUserId])
  @@map("events")
}

model Session {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  refreshTokenHash    String    @unique @map("refresh_token_hash") @db.Char(64)
  refreshTokenVersion Int       @default(1) @map("refresh_token_version")
  lastRotatedAt       DateTime  @default(now()) @map("last_rotated_at") @db.Timestamptz(3)
  userAgent           String?   @map("user_agent") @db.VarChar(512)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("email_verification_tokens")
}
